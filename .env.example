# Copy this file to .env and fill in real values. Do not commit .env.

# AES-256-GCM encryption key. Required. The server refuses to start without it.
ENCRYPTION_KEY=change-me-to-a-strong-random-value

# MongoDB connection URI.
MONGO_URI=mongodb://localhost:27017

# MongoDB credentials used by docker-compose.
MONGO_USER=change-me
MONGO_PASSWORD=change-me

# Optional. If set, GET /metrics requires an Authorization Bearer token that matches.
METRICS_TOKEN=
